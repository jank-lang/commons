(ns implot3d-sys.example
  (:include "numbers"
            "GLFW/glfw3.h"
            "imgui.h"
            "imgui_impl_glfw.h"
            "imgui_impl_opengl2.h"
            "implot3d.h"))

;; TODO: jank can't deduce the template scalar type on ImPlot::PlotLine yet, so
;; specify it explicitly here.
(cpp/raw "
void PlotLineD(const char* label_id,
  jank::runtime::obj::persistent_vector_ref xs,
  jank::runtime::obj::persistent_vector_ref ys,
  jank::runtime::obj::persistent_vector_ref zs)
{
  auto v_xs = jank::runtime::convert<std::vector<double>>::from_object(xs);
  auto v_ys = jank::runtime::convert<std::vector<double>>::from_object(ys);
  auto v_zs = jank::runtime::convert<std::vector<double>>::from_object(zs);

  ImPlot3D::PlotLine(label_id, v_xs.data(), v_ys.data(), v_zs.data(), v_xs.size());
}")

(defn -main []
  (cpp/glfwInit)

  (let [window* (cpp/glfwCreateWindow 400 300
                                      "jank"
                                      cpp/nullptr cpp/nullptr)]
    (cpp/glfwMakeContextCurrent window*)
    (cpp/ImGui.CreateContext)
    (cpp/ImGui_ImplGlfw_InitForOpenGL window* true)
    (cpp/ImGui_ImplOpenGL2_Init)
    (cpp/ImPlot3D.CreateContext)

    (let [xs (vec (range 0.0 (* 20 cpp/std.numbers.pi) 0.1))
          ys (mapv #(cpp/cos %) xs)
          zs (mapv #(cpp/sin %) xs)]
      (while (cpp/! (cpp/glfwWindowShouldClose window*))
        (cpp/glfwPollEvents)
        (cpp/ImGui_ImplOpenGL2_NewFrame)
        (cpp/ImGui_ImplGlfw_NewFrame)
        (cpp/ImGui.NewFrame)

        (when (cpp/ImGui.Begin "jank")
          (when (cpp/ImPlot3D.BeginPlot "my plot")
            (cpp/PlotLineD "my line" xs ys zs)
            (cpp/ImPlot3D.EndPlot)))
        (cpp/ImGui.End)

        (cpp/ImGui.Render)
        (cpp/ImGui_ImplOpenGL2_RenderDrawData (cpp/ImGui.GetDrawData))
        (cpp/glfwSwapBuffers window*)))

    (cpp/glfwTerminate)))
