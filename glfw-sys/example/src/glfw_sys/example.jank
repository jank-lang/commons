(ns glfw-sys.example
  (:include (if (= cpp/jtl.current_platform cpp/jtl.platform.macos_like)
              "OpenGL/gl.h"
              "GL/gl.h")
            "GLFW/glfw3.h"))

(defn -main []
  (cpp/glfwInit)

  (let [window* (cpp/glfwCreateWindow 400 300 "jank" cpp/nullptr cpp/nullptr)]
    (cpp/glfwMakeContextCurrent window*)

    (cpp/glClearColor (/ 100 255.0) (/ 149 255.0) (/ 237 255.0) 1.0)

    (while (cpp/! (cpp/glfwWindowShouldClose window*))
      (cpp/glfwPollEvents)

      (let [width 0
            height 0]
        (cpp/glfwGetFramebufferSize window* (cpp/& width) (cpp/& height))
        (cpp/glViewport 0 0 width, height)
        (cpp/glClear cpp/GL_COLOR_BUFFER_BIT))

      (cpp/glfwSwapBuffers window*))

    (cpp/glfwTerminate)))
